# Copy to .env.local and fill in. `npm run setup` fills the Supabase values for local development.

# Public URL of the app (auth redirects, links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local values are printed by `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used for checks, scheduled checks and seeding. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# USCIS Case Status API (sandbox). Leave the client ID empty to use recorded responses instead (local only).
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
USCIS_TOKEN_URL=https://api-int.uscis.gov/oauth/accesstoken
USCIS_API_BASE_URL=https://api-int.uscis.gov/case-status

# Email notifications on status changes (optional locally)
RESEND_API_KEY=
EMAIL_FROM=Kinstamp <notifications@kinstamp.com>

# Case assistant (optional locally)
ANTHROPIC_API_KEY=

# Protects the scheduled-checks endpoint called by Vercel Cron
CRON_SECRET=
